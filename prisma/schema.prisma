// ============================================================
// ZERO — schema.prisma (bozza V1)
// Basato su 11_Database_Architecture.md
//
// Decisioni prese per risolvere ambiguità del documento originale:
// 1. Purchase: FK dedicate e nullable invece di (Tipo, OggettoID)
//    polimorfico -> integrità referenziale reale a livello DB.
// 2. DiscountCode: FK opzionali verso l'oggetto a cui si applica.
//    Se tutte null => sconto valido su tutta l'offerta del creator.
// 3. Community: campo isFree esplicito, prezzo nullable.
// 4. Analytics: trattata come SNAPSHOT storico (capturedAt), non
//    come specchio in tempo reale di Journey/Creator — evita la
//    duplicazione "vietata" dal principio del documento originale.
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------
// ENUM
// ------------------------------------------------------------

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum CreatorStatus {
  ACTIVE
  SUSPENDED
}

enum JourneyStatus {
  DRAFT
  DISCOVERY
  PUBLISHED
  ARCHIVED
}

enum UpdateType {
  TEXT
  IMAGE
  VIDEO
  POLL
  QUESTION
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum PurchaseType {
  COMMUNITY
  WORKSHOP
  EVENT
  DIGITAL_PRODUCT
  PERSONAL_SERVICE
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum ReportTargetType {
  USER
  CREATOR
  JOURNEY
  UPDATE
  COMMENT
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum LikeTargetType {
  EPISODE
  UPDATE
}

enum NotificationType {
  NEW_FOLLOWER
  NEW_MEMBER
  PURCHASE
  TIP
  UPDATE
  WORKSHOP
  EVENT
  NEW_EPISODE
  NEW_JOURNEY
}

// ------------------------------------------------------------
// USER
// ------------------------------------------------------------

model User {
  id            String        @id @default(uuid())
  name          String
  username      String?       @unique
  email         String        @unique
  emailVerified Boolean       @default(false)
  avatarUrl     String? // mappato da Better Auth come campo "image", vedi user.fields in lib/auth.ts
  coverUrl      String? // foto di copertina del Profilo pubblico
  bio           String?
  location      String?
  // Categorie scelte durante l'Onboarding (stessa lista fissa di JOURNEY_CATEGORIES,
  // vedi lib/constants/categories.ts). Vuoto = Onboarding non ancora completato.
  interests     String[]      @default([])
  status        AccountStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  // Non null = l'utente ha chiesto la cancellazione dell'account: nascosto ovunque da subito
  // (stesso significato di deletedAt sugli altri modelli), ma la riga esiste ancora finché non
  // scatta la cancellazione definitiva. scheduledDeletionAt = quando scatterà (10 giorni di
  // grazia): se l'utente rifà login prima di quella data può riattivare (vedi lib/account/deletion.ts).
  deletedAt           DateTime?
  scheduledDeletionAt DateTime?

  sessions  Session[]
  accounts  Account[]

  creator            Creator?
  // Follow universale tra persone (non legato allo stato di Creator): "following" sono le
  // righe in cui questo utente è chi segue, "followers" quelle in cui è chi viene seguito.
  following          Follow[]          @relation("Following")
  followers          Follow[]          @relation("Followers")
  purchases          Purchase[]
  communityMembers   CommunityMember[]
  tipsSent           Tip[]
  notifications      Notification[]
  reports            Report[]
  journeyProgresses  JourneyProgress[]
  episodeProgresses  EpisodeProgress[]
  likes              Like[]
  updateVotes        UpdateVote[]
  updateViews        UpdateView[]
  updateAnswers      UpdateAnswer[]
  updateReactions    UpdateReaction[]
  conversationsAsA   Conversation[]    @relation("ConversationsAsA")
  conversationsAsB   Conversation[]    @relation("ConversationsAsB")
  messagesSent       Message[]

  @@map("users")
}

// ------------------------------------------------------------
// AUTH (Better Auth) — tabelle richieste dall'adapter Prisma
// ------------------------------------------------------------

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String? // hash della password, solo per providerId = "credential"
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ------------------------------------------------------------
// CREATOR
// ------------------------------------------------------------

model Creator {
  id           String        @id @default(uuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id])
  displayName  String
  description  String?
  trustLevel   Int           @default(0)
  status       CreatorStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  journeys         Journey[]
  updates          Update[]
  community        Community?
  workshops        Workshop[]
  events           Event[]
  digitalProducts  DigitalProduct[]
  services         PersonalService[]
  discountCodes    DiscountCode[]
  tipsReceived     Tip[]
  analyticsSnapshots Analytics[]

  // Vincolo applicativo (non esprimibile in Prisma): un solo Journey
  // con status != ARCHIVED per creator. Da far rispettare nella business logic.

  @@map("creators")
}

// ------------------------------------------------------------
// JOURNEY / CHAPTER / EPISODE
// ------------------------------------------------------------

model Journey {
  id             String        @id @default(uuid())
  creatorId      String
  creator        Creator       @relation(fields: [creatorId], references: [id])
  title          String
  description    String?
  coverUrl       String?
  category       String?
  tags           String[]
  status         JourneyStatus @default(DRAFT)
  order          Int // Posizione manuale nella lista dei Journey del creator (Profilo), non collegata alla data di creazione — vedi moveJourney in lib/actions/journey.ts.
  discoveryEndsAt DateTime?
  journeyScore   Float         @default(0) // Journey Score 0-100, ricalcolato al massimo 1x/giorno (vedi lib/scoring/journeyScore.ts)
  journeyScoreUpdatedAt DateTime? // null = mai calcolato; usato per sapere quando il punteggio è "stale" e va ricalcolato
  viewsCount     Int           @default(0) // contatore semplice, incrementato a ogni caricamento della Pagina Journey pubblica
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  publishedAt    DateTime? // valorizzato solo la prima volta che il Journey passa da Draft a Published; non cambia più in seguito
  deletedAt      DateTime?

  chapters    Chapter[]
  episodes    Episode[]
  progresses  JourneyProgress[]
  analyticsSnapshots Analytics[]
  linkedByUpdates Update[]

  @@index([creatorId, order])
  @@map("journeys")
}

model Chapter {
  id          String   @id @default(uuid())
  journeyId   String
  journey     Journey  @relation(fields: [journeyId], references: [id])
  title       String
  description String?
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  episodes Episode[]

  @@index([journeyId, order])
  @@map("chapters")
}

model Episode {
  id          String   @id @default(uuid())
  // Ogni Episodio appartiene sempre a un Journey; il Capitolo è un livello
  // organizzativo opzionale (05_Journey.md), quindi chapterId può essere null:
  // un Episodio senza Capitolo si legge nella sequenza cronologica del Journey.
  journeyId   String
  journey     Journey  @relation(fields: [journeyId], references: [id])
  chapterId   String?
  chapter     Chapter? @relation(fields: [chapterId], references: [id])
  title       String
  videoKey    String?
  // Copertina propria dell'Episodio (chiave R2): se assente, l'interfaccia usa la copertina del
  // Journey come riserva (vedi lib/media/resolveCoverUrl.ts).
  posterKey   String?
  // Durata del video in secondi, letta automaticamente dal browser al caricamento
  // (vedi lib/media/readVideoDuration.ts) — non richiede transcodifica lato server.
  durationSec Int?
  caption     String?
  // Data reale in cui l'evento è accaduto, separata dall'ordine narrativo
  // (vedi 05_Journey.md: ordine narrativo e cronologia reale sono informazioni distinte).
  occurredAt  DateTime @default(now())
  order       Int
  // null = Bozza, visibile solo al creator. Sempre un passaggio esplicito del creator, mai
  // valorizzato in automatico alla creazione (a differenza del vecchio comportamento in cui ogni
  // episodio era pubblico da subito).
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  progress    EpisodeProgress[]
  linkedByUpdates Update[]

  @@index([journeyId, chapterId, order])
  @@map("episodes")
}

// Tiene traccia di "Continua il tuo Journey": solo il puntatore all'ultimo episodio visto.
// La posizione video e il completamento vivono per episodio in EpisodeProgress, non qui:
// una sola riga per Journey non basta a ricordare quali episodi singoli sono stati completati.
model JourneyProgress {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  journeyId         String
  journey           Journey   @relation(fields: [journeyId], references: [id])
  currentEpisodeId  String?
  updatedAt         DateTime  @updatedAt

  @@unique([userId, journeyId])
  @@map("journey_progresses")
}

// Posizione di riproduzione e completamento per singolo episodio e singolo utente. Base per la
// ripresa esatta del video e per un futuro segnale di completamento reale (Trust Score/Algoritmo,
// vedi 08_Algorithm.md "completamento dei Journey" / "tempo di fruizione significativo").
model EpisodeProgress {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  episodeId   String
  episode     Episode   @relation(fields: [episodeId], references: [id])
  positionSec Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, episodeId])
  @@map("episode_progresses")
}

// ------------------------------------------------------------
// UPDATE
// ------------------------------------------------------------

model Update {
  id          String     @id @default(uuid())
  creatorId   String
  creator     Creator    @relation(fields: [creatorId], references: [id])
  type        UpdateType
  content     String
  // Chiave del file su Cloudflare R2 (foto o video, a seconda di `type`), stesso pattern già in
  // uso per Episode.videoKey e User.avatarUrl/coverUrl — mai il file stesso nel database.
  mediaKey    String?
  // Un Update di tipo IMAGE/VIDEO può facoltativamente comportarsi anche da Domanda (risposta
  // privata, come il tipo QUESTION puro) invece che da semplice foto/video con didascalia — non
  // esclusivo con `type`, un aggiunta in più. Per gli Update di tipo QUESTION puro resta false:
  // il controllo "è una domanda?" guarda `type === QUESTION || isQuestion`, mai solo questo campo.
  isQuestion  Boolean    @default(false)
  // Un Update può facoltativamente puntare a un Episodio o Journey del creator (es. "è uscito il
  // nuovo episodio"), indipendentemente dal suo `type` — non sono a vicenda esclusivi con testo/
  // foto/video/sondaggio/domanda, sono un aggancio in più.
  linkedJourneyId String?
  linkedJourney   Journey? @relation(fields: [linkedJourneyId], references: [id])
  linkedEpisodeId String?
  linkedEpisode   Episode? @relation(fields: [linkedEpisodeId], references: [id])
  publishedAt DateTime   @default(now())
  archivedAt  DateTime? // impostato automaticamente 24h dopo la pubblicazione
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  pollOptions PollOption[]
  votes       UpdateVote[]
  views       UpdateView[]
  answers     UpdateAnswer[]
  reactions   UpdateReaction[]

  @@map("updates")
}

// Opzioni di un Update di tipo POLL (2-4 per sondaggio, vedi lib/constants/updates.ts).
model PollOption {
  id        String   @id @default(uuid())
  updateId  String
  update    Update   @relation(fields: [updateId], references: [id], onDelete: Cascade)
  label     String
  order     Int
  createdAt DateTime @default(now())

  votes UpdateVote[]

  @@index([updateId, order])
  @@map("update_poll_options")
}

// Un voto per persona per sondaggio, non modificabile dopo il voto (decisione presa con Manuel).
model UpdateVote {
  id        String     @id @default(uuid())
  updateId  String
  update    Update     @relation(fields: [updateId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  createdAt DateTime   @default(now())

  @@unique([updateId, userId])
  @@map("update_votes")
}

// Traccia chi ha già visto quale Update: base per il contorno "visto/non visto" dei cerchi
// in stile Stories nella Home (nessuna tabella equivalente esisteva prima).
model UpdateView {
  id       String   @id @default(uuid())
  updateId String
  update   Update   @relation(fields: [updateId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  viewedAt DateTime @default(now())

  @@unique([updateId, userId])
  @@map("update_views")
}

// Risposta a un Update di tipo QUESTION: visibile solo al creator (mai pubblica), una
// risposta per persona per domanda.
model UpdateAnswer {
  id        String   @id @default(uuid())
  updateId  String
  update    Update   @relation(fields: [updateId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@unique([updateId, userId])
  @@map("update_answers")
}

// Reazione rapida a un tocco (emoji), non un commento: un tocco per persona per Update, il
// tocco più recente sostituisce il precedente se la persona cambia idea.
model UpdateReaction {
  id        String   @id @default(uuid())
  updateId  String
  update    Update   @relation(fields: [updateId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  emoji     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([updateId, userId])
  @@map("update_reactions")
}

// ------------------------------------------------------------
// COMMUNITY
// ------------------------------------------------------------

model Community {
  id          String        @id @default(uuid())
  creatorId   String        @unique
  creator     Creator       @relation(fields: [creatorId], references: [id])
  title       String
  description String?
  isFree      Boolean       @default(true)
  price       Decimal?      @db.Money // null se isFree = true
  status      ListingStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members   CommunityMember[]
  purchases Purchase[]

  @@map("communities")
}

model CommunityMember {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  joinedAt    DateTime  @default(now())
  status      ListingStatus @default(ACTIVE)

  @@unique([communityId, userId])
  @@map("community_members")
}

// ------------------------------------------------------------
// WORKSHOP / EVENT / DIGITAL PRODUCT / PERSONAL SERVICE
// ------------------------------------------------------------

model Workshop {
  id          String        @id @default(uuid())
  creatorId   String
  creator     Creator       @relation(fields: [creatorId], references: [id])
  title       String
  description String?
  price       Decimal       @db.Money
  status      ListingStatus @default(DRAFT)
  presaleReleaseAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  purchases     Purchase[]
  discountCodes DiscountCode[]

  @@map("workshops")
}

model Event {
  id          String        @id @default(uuid())
  creatorId   String
  creator     Creator       @relation(fields: [creatorId], references: [id])
  title       String
  description String?
  price       Decimal       @db.Money
  status      ListingStatus @default(DRAFT)
  presaleReleaseAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  purchases     Purchase[]
  discountCodes DiscountCode[]

  @@map("events")
}

model DigitalProduct {
  id          String        @id @default(uuid())
  creatorId   String
  creator     Creator       @relation(fields: [creatorId], references: [id])
  title       String
  description String?
  price       Decimal       @db.Money
  fileUrl     String
  status      ListingStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  purchases     Purchase[]
  discountCodes DiscountCode[]

  @@map("digital_products")
}

model PersonalService {
  id          String        @id @default(uuid())
  creatorId   String
  creator     Creator       @relation(fields: [creatorId], references: [id])
  title       String
  description String?
  price       Decimal       @db.Money
  status      ListingStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  purchases     Purchase[]
  discountCodes DiscountCode[]

  @@map("personal_services")
}

// ------------------------------------------------------------
// PURCHASE — FK dedicate invece di riferimento polimorfico
// ------------------------------------------------------------

model Purchase {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  type       PurchaseType

  communityId       String?
  community         Community?       @relation(fields: [communityId], references: [id])
  workshopId        String?
  workshop          Workshop?        @relation(fields: [workshopId], references: [id])
  eventId           String?
  event             Event?           @relation(fields: [eventId], references: [id])
  digitalProductId  String?
  digitalProduct    DigitalProduct?  @relation(fields: [digitalProductId], references: [id])
  personalServiceId String?
  personalService   PersonalService? @relation(fields: [personalServiceId], references: [id])

  discountCodeId String?
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id])

  price      Decimal        @db.Money
  commission Decimal        @db.Money
  status     PurchaseStatus @default(PENDING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  payment Payment?

  // Vincolo applicativo: esattamente una tra communityId/workshopId/eventId/
  // digitalProductId/personalServiceId deve essere valorizzata, coerente con `type`.
  // Da imporre con un CHECK constraint SQL o validazione a livello service.

  @@map("purchases")
}

// ------------------------------------------------------------
// TIP
// ------------------------------------------------------------

model Tip {
  id        String   @id @default(uuid())
  creatorId String
  creator   Creator  @relation(fields: [creatorId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Decimal  @db.Money
  anonymous Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("tips")
}

// ------------------------------------------------------------
// DISCOUNT CODE — con targeting esplicito
// ------------------------------------------------------------

model DiscountCode {
  id          String   @id @default(uuid())
  creatorId   String
  creator     Creator  @relation(fields: [creatorId], references: [id])
  code        String   @unique
  percentage  Int // 1-100
  maxUses     Int?
  currentUses Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Se tutti null => sconto valido su tutta l'offerta del creator
  workshopId        String?
  workshop          Workshop?        @relation(fields: [workshopId], references: [id])
  eventId           String?
  event             Event?           @relation(fields: [eventId], references: [id])
  digitalProductId  String?
  digitalProduct    DigitalProduct?  @relation(fields: [digitalProductId], references: [id])
  personalServiceId String?
  personalService   PersonalService? @relation(fields: [personalServiceId], references: [id])

  purchases Purchase[]

  @@map("discount_codes")
}

// ------------------------------------------------------------
// FOLLOW — persona segue persona, indipendente dallo stato di Creator
// (chi ha pubblicato un Journey è comunque un utente come tutti gli
// altri, vedi 00-project-context.md sezione "Modello utente unico")
// ------------------------------------------------------------

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("Following", fields: [followerId], references: [id])
  followingId String
  following   User     @relation("Followers", fields: [followingId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@map("follows")
}

// ------------------------------------------------------------
// MESSAGING — conversazioni 1:1, permesse se almeno una delle due persone
// segue l'altra (non serve il follow reciproco, vedi 00-project-context.md,
// sezione "Follow universale"). Solo testo nella V1 (19_Messaging.md).
// ------------------------------------------------------------

// userAId/userBId sono normalizzati (userAId sempre < userBId, ordine lessicografico
// sugli id) così la coppia di persone ha sempre una sola riga possibile, a prescindere
// da chi ha scritto per primo — a differenza di Follow, dove le due direzioni contano
// come righe distinte.
model Conversation {
  id            String   @id @default(uuid())
  userAId       String
  userA         User     @relation("ConversationsAsA", fields: [userAId], references: [id])
  userBId       String
  userB         User     @relation("ConversationsAsB", fields: [userBId], references: [id])
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages Message[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ------------------------------------------------------------
// LIKE (Episodi e Update — nessun sistema di commenti, vedi 12_MVP_Features.md)
// ------------------------------------------------------------

model Like {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  targetType LikeTargetType
  // Id dell'Episodio o dell'Update, a seconda di targetType: nessuna relation
  // diretta perché un solo campo Like deve poter puntare a due modelli diversi.
  targetId   String
  createdAt  DateTime       @default(now())

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("likes")
}

// ------------------------------------------------------------
// NOTIFICATION
// ------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  content   String
  // Percorso interno da aprire al click (es. "/journeys/abc"), null per i tipi che non ne hanno bisogno.
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

// ------------------------------------------------------------
// ANALYTICS — snapshot storico, non specchio in tempo reale
// ------------------------------------------------------------

model Analytics {
  id              String   @id @default(uuid())
  creatorId       String
  creator         Creator  @relation(fields: [creatorId], references: [id])
  journeyId       String?
  journey         Journey? @relation(fields: [journeyId], references: [id])
  completionRate  Float
  journeyScore    Float
  inspirationRate Float
  trustLevel      Int
  capturedAt      DateTime @default(now())

  @@index([creatorId, capturedAt])
  @@map("analytics_snapshots")
}

// ------------------------------------------------------------
// REPORT (moderazione — schema minimo, da estendere con Trust System)
// ------------------------------------------------------------

model Report {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  targetType ReportTargetType
  targetId   String
  reason     String
  status     ReportStatus     @default(PENDING)
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?

  @@map("reports")
}

// ------------------------------------------------------------
// PAYMENT
// ------------------------------------------------------------

model Payment {
  id         String        @id @default(uuid())
  purchaseId String        @unique
  purchase   Purchase      @relation(fields: [purchaseId], references: [id])
  stripeId   String        @unique
  amount     Decimal       @db.Money
  commission Decimal       @db.Money
  status     PaymentStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@map("payments")
}
