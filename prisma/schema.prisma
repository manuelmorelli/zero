// ============================================================
// ZERO — schema.prisma (bozza V1)
// Basato su 11_Database_Architecture.md
//
// Decisioni prese per risolvere ambiguità del documento originale:
// 1. Purchase: FK dedicate e nullable invece di (Tipo, OggettoID)
//    polimorfico -> integrità referenziale reale a livello DB.
// 2. DiscountCode: FK opzionali verso l'oggetto a cui si applica.
//    Se tutte null => sconto valido su tutta l'offerta del creator.
// 3. Community: campo isFree esplicito, prezzo nullable.
// 4. Analytics: trattata come SNAPSHOT storico (capturedAt), non
//    come specchio in tempo reale di Journey/Creator — evita la
//    duplicazione "vietata" dal principio del documento originale.
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------
// ENUM
// ------------------------------------------------------------

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum CreatorStatus {
  ACTIVE
  SUSPENDED
}

enum JourneyStatus {
  DRAFT
  DISCOVERY
  PUBLISHED
  ARCHIVED
}

// Stato della versione leggera del video di un Episodio su Cloudflare Stream, vedi lib/stream.ts.
enum LightVideoStatus {
  PENDING
  READY
  FAILED
}

enum UpdateType {
  TEXT
  IMAGE
  VIDEO
  POLL
  QUESTION
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum PurchaseType {
  COMMUNITY
  WORKSHOP
  EVENT
  DIGITAL_PRODUCT
  PERSONAL_SERVICE
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum ReportTargetType {
  USER
  CREATOR
  JOURNEY
  UPDATE
  COMMENT
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum LikeTargetType {
  EPISODE
  UPDATE
}

enum NotificationType {
  NEW_FOLLOWER
  NEW_MEMBER
  PURCHASE
  TIP
  UPDATE
  WORKSHOP
  EVENT
  NEW_EPISODE
  NEW_JOURNEY
  DIGITAL_PRODUCT
  PERSONAL_SERVICE
}

// ------------------------------------------------------------
// USER
// ------------------------------------------------------------

model User {
  id            String        @id @default(uuid())
  name          String
  username      String?       @unique
  email         String        @unique
  emailVerified Boolean       @default(false)
  avatarUrl     String? // mappato da Better Auth come campo "image", vedi user.fields in lib/auth.ts
  coverUrl      String? // foto di copertina del Profilo pubblico
  bio           String?
  location      String?
  // Data di nascita, richiesta in registrazione dal Punto 6 (Legale) dell'allineamento
  // per far rispettare l'età minima di 16 anni (vedi lib/auth.ts). Null per gli account
  // creati prima di questa regola (non retroattiva). Mai mostrata pubblicamente.
  dateOfBirth   DateTime?
  // Categorie scelte durante l'Onboarding (stessa lista fissa di JOURNEY_CATEGORIES,
  // vedi lib/constants/categories.ts). Vuoto = Onboarding non ancora completato.
  interests     String[]      @default([])
  status        AccountStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  // Non null = l'utente ha chiesto la cancellazione dell'account: nascosto ovunque da subito
  // (stesso significato di deletedAt sugli altri modelli), ma la riga esiste ancora finché non
  // scatta la cancellazione definitiva. scheduledDeletionAt = quando scatterà (10 giorni di
  // grazia): se l'utente rifà login prima di quella data può riattivare (vedi lib/account/deletion.ts).
  deletedAt           DateTime?
  scheduledDeletionAt DateTime?

  // Impostazioni Privacy (Settings > Privacy, 2026-10-01): chi non segue ancora questo utente
  // vede solo nome/foto/bio col tasto Segui, non Journey/Update. Il "segui" resta istantaneo
  // come oggi, nessuna richiesta da approvare. Pensato per chi guarda contenuti (categorie
  // delicate come Recovery & Sobriety/Mental Health), non per i creator: un Journey pubblicato
  // resta comunque scopribile in Discovery/Ricerca, vedi lib/profile/profileVisibility.ts.
  isPrivate Boolean @default(false)

  // Preferenze notifiche (Settings > Notifications): quali eventi generano una notifica per
  // questo utente. Regola opt-out (default true) per non silenziare tutti al lancio della
  // funzione. Vedi lib/notifications.ts per dove vengono lette.
  notifyNewEpisode       Boolean @default(true)
  notifyNewJourney       Boolean @default(true)
  notifyQuestionAnswered Boolean @default(true)
  notifyNewFollower      Boolean @default(true)
  // Un solo interruttore per tutti e 4 i tipi di "mattoncini" Community (Workshop, Evento,
  // Prodotto Digitale, Consulenza 1:1, vedi Punto 8 dell'allineamento) invece di quattro
  // separati: sono la stessa famiglia di contenuto agli occhi di chi riceve la notifica.
  notifyNewOffering      Boolean @default(true)

  sessions  Session[]
  accounts  Account[]

  creator            Creator?
  // Follow universale tra persone (non legato allo stato di Creator): "following" sono le
  // righe in cui questo utente è chi segue, "followers" quelle in cui è chi viene seguito.
  following          Follow[]          @relation("Following")
  followers          Follow[]          @relation("Followers")
  purchases          Purchase[]
  communityMembers   CommunityMember[]
  tipsSent           Tip[]
  notifications      Notification[]
  reports            Report[]
  workshopRsvps      WorkshopRsvp[]
  eventRsvps         EventRsvp[]
  journeyProgresses  JourneyProgress[]
  episodeProgresses  EpisodeProgress[]
  likes              Like[]
  updateVotes        UpdateVote[]
  updateViews        UpdateView[]
  updateAnswers      UpdateAnswer[]
  updateReactions    UpdateReaction[]
  conversationsAsA   Conversation[]    @relation("ConversationsAsA")
  conversationsAsB   Conversation[]    @relation("ConversationsAsB")
  messagesSent       Message[]
  forumMessages      ForumMessage[]
  aiImageGenerations AiImageGeneration[]
  // "blocksMade" = righe in cui questo utente ha bloccato qualcuno, "blockedBy" quelle in cui
  // è lui ad essere stato bloccato. Vedi model Block.
  blocksMade Block[] @relation("BlocksMade")
  blockedBy  Block[] @relation("BlockedBy")

  @@map("users")
}

// ------------------------------------------------------------
// AUTH (Better Auth) — tabelle richieste dall'adapter Prisma
// ------------------------------------------------------------

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String? // hash della password, solo per providerId = "credential"
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ------------------------------------------------------------
// CREATOR
// ------------------------------------------------------------

model Creator {
  id           String        @id @default(uuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id])
  displayName  String
  description  String?
  trustLevel   Int           @default(0)
  // Video/card di presentazione da caricare per attivare il Trust Score (lib/profile/trustScore.ts).
  // Null finché non lo carica: il Trust Score resta disattivato (nessun badge) fino ad allora.
  presentationVideoUrl String?
  // Data di accettazione delle Community Guidelines, richiesta (insieme a profilo compilato e
  // video di presentazione) prima di poter pubblicare per la prima volta, vedi lib/creator.ts
  // (getPublishReadiness). Null = non ancora accettate, nessun grandfathering per gli account
  // creati prima di questa regola.
  guidelinesAcceptedAt DateTime?
  status       CreatorStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  journeys         Journey[]
  updates          Update[]
  community        Community?
  workshops        Workshop[]
  events           Event[]
  digitalProducts  DigitalProduct[]
  services         PersonalService[]
  discountCodes    DiscountCode[]
  tipsReceived     Tip[]
  analyticsSnapshots Analytics[]

  // Vincolo applicativo (non esprimibile in Prisma): un solo Journey
  // con status != ARCHIVED per creator. Da far rispettare nella business logic.

  @@map("creators")
}

// ------------------------------------------------------------
// JOURNEY / CHAPTER / EPISODE
// ------------------------------------------------------------

model Journey {
  id             String        @id @default(uuid())
  creatorId      String
  creator        Creator       @relation(fields: [creatorId], references: [id])
  title          String
  description    String?
  coverUrl       String?
  category       String?
  tags           String[]
  status         JourneyStatus @default(DRAFT)
  order          Int // Posizione manuale nella lista dei Journey del creator (Profilo), non collegata alla data di creazione — vedi moveJourney in lib/actions/journey.ts.
  discoveryEndsAt DateTime?
  journeyScore   Float         @default(0) // Journey Score 0-100, ricalcolato al massimo 1x/giorno (vedi lib/scoring/journeyScore.ts)
  journeyScoreUpdatedAt DateTime? // null = mai calcolato; usato per sapere quando il punteggio è "stale" e va ricalcolato
  viewsCount     Int           @default(0) // contatore semplice, incrementato a ogni caricamento della Pagina Journey pubblica
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  publishedAt    DateTime? // valorizzato solo la prima volta che il Journey passa da Draft a Published; non cambia più in seguito
  deletedAt      DateTime?

  chapters    Chapter[]
  episodes    Episode[]
  progresses  JourneyProgress[]
  analyticsSnapshots Analytics[]
  linkedByUpdates Update[]
  wildcardPicks WildcardPick[]
  forumMessages ForumMessage[]

  @@index([creatorId, order])
  @@map("journeys")
}

model Chapter {
  id          String   @id @default(uuid())
  journeyId   String
  journey     Journey  @relation(fields: [journeyId], references: [id])
  title       String
  description String?
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  episodes Episode[]

  @@index([journeyId, order])
  @@map("chapters")
}

model Episode {
  id          String   @id @default(uuid())
  // Ogni Episodio appartiene sempre a un Journey; il Capitolo è un livello
  // organizzativo opzionale (05_Journey.md), quindi chapterId può essere null:
  // un Episodio senza Capitolo si legge nella sequenza cronologica del Journey.
  journeyId   String
  journey     Journey  @relation(fields: [journeyId], references: [id])
  chapterId   String?
  chapter     Chapter? @relation(fields: [chapterId], references: [id])
  title       String
  videoKey    String?
  // Copertina propria dell'Episodio (chiave R2): se assente, l'interfaccia usa la copertina del
  // Journey come riserva (vedi lib/media/resolveCoverUrl.ts).
  posterKey   String?
  // Durata del video in secondi, letta automaticamente dal browser al caricamento
  // (vedi lib/media/readVideoDuration.ts) — non richiede transcodifica lato server.
  durationSec Int?
  // Versione leggera del video (Cloudflare Stream), generata in background dopo la pubblicazione
  // per chi ha connessione lenta (vedi lib/stream.ts). Il file originale su R2 (videoKey) non viene
  // mai toccato: questi campi descrivono solo una copia aggiuntiva usata per lo streaming adattivo.
  // null = mai avviata (nessun video, oppure Stream non ancora configurato); PENDING = in
  // elaborazione su Cloudflare; READY = pronta, lightVideoPlaybackUrl valorizzato; FAILED = errore,
  // il player resta sul video originale.
  lightVideoStatus      LightVideoStatus?
  lightVideoId          String? // uid del video su Cloudflare Stream, serve per cancellarlo se il video originale viene sostituito
  lightVideoPlaybackUrl String? // URL manifest HLS restituito da Cloudflare Stream, valorizzato solo quando lightVideoStatus = READY
  caption     String?
  // Data reale in cui l'evento è accaduto, separata dall'ordine narrativo
  // (vedi 05_Journey.md: ordine narrativo e cronologia reale sono informazioni distinte).
  occurredAt  DateTime @default(now())
  order       Int
  // null = Bozza, visibile solo al creator. Sempre un passaggio esplicito del creator, mai
  // valorizzato in automatico alla creazione (a differenza del vecchio comportamento in cui ogni
  // episodio era pubblico da subito).
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  progress    EpisodeProgress[]
  linkedByUpdates Update[]
  moments     EpisodeMoment[]

  @@index([journeyId, chapterId, order])
  @@map("episodes")
}

// La "Mappa dei Momenti": appunti scritti che l'AI ricava da un episodio guardandolo una volta sola
// (lib/ai/episodeMoments.ts), così ricerca semantica, trailer automatico e un futuro "Percorso su
// Misura" leggono solo testo già pronto invece di far rianalizzare il video ogni volta. Il video
// originale su R2 resta sempre la fonte vera e non viene mai toccato: questi appunti sono materiale
// aggiuntivo, rigenerabile in qualunque momento riprocessando l'episodio.
model EpisodeMoment {
  id           String   @id @default(uuid())
  episodeId    String
  episode      Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  timestampSec Int
  description  String
  // Embedding testuale (gemini-embedding-2): confrontato in codice applicativo quando servirà la
  // ricerca semantica, non con una query SQL vettoriale — alla scala attuale della libreria non
  // serve l'estensione pgvector, si può aggiungere in futuro se il volume crescerà molto.
  embedding    Json
  createdAt    DateTime @default(now())

  @@index([episodeId])
  @@map("episode_moments")
}

// Tiene traccia di "Continua il tuo Journey": solo il puntatore all'ultimo episodio visto.
// La posizione video e il completamento vivono per episodio in EpisodeProgress, non qui:
// una sola riga per Journey non basta a ricordare quali episodi singoli sono stati completati.
model JourneyProgress {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  journeyId         String
  journey           Journey   @relation(fields: [journeyId], references: [id])
  currentEpisodeId  String?
  updatedAt         DateTime  @updatedAt

  @@unique([userId, journeyId])
  @@map("journey_progresses")
}

// Posizione di riproduzione e completamento per singolo episodio e singolo utente. Base per la
// ripresa esatta del video e per un futuro segnale di completamento reale (Trust Score/Algoritmo,
// vedi 08_Algorithm.md "completamento dei Journey" / "tempo di fruizione significativo").
model EpisodeProgress {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  episodeId   String
  episode     Episode   @relation(fields: [episodeId], references: [id])
  positionSec Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, episodeId])
  @@map("episode_progresses")
}

// ------------------------------------------------------------
// FORUM (Community > Forum, una bacheca per Journey)
// ------------------------------------------------------------

// Bacheca di discussione testuale legata a un Journey (non alla Community in generale): chi lo sta
// seguendo e il creator si confrontano qui, separata dalle Activities (Workshop/Event/Shop/1:1).
// V1 volutamente semplice (richiesto da Manuel, 2026-10-02): un'unica bacheca per Journey, ordine
// cronologico, nessuna divisione per Capitolo e nessuna risposta a thread — entrambe annotate come
// upgrade futuri in docs/94_Product_Backlog.md. Solo testo, niente foto/video.
model ForumMessage {
  id        String    @id @default(uuid())
  journeyId String
  journey   Journey   @relation(fields: [journeyId], references: [id])
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime  @default(now())
  // Cancellazione propria (autore) o moderazione del creator sul forum del proprio Journey:
  // soft delete, stesso pattern già in uso altrove nello schema (Episode, Journey...).
  deletedAt DateTime?

  @@index([journeyId, createdAt])
  @@map("forum_messages")
}

// ------------------------------------------------------------
// UPDATE
// ------------------------------------------------------------

model Update {
  id          String     @id @default(uuid())
  creatorId   String
  creator     Creator    @relation(fields: [creatorId], references: [id])
  type        UpdateType
  content     String
  // Chiave del file su Cloudflare R2 (foto o video, a seconda di `type`), stesso pattern già in
  // uso per Episode.videoKey e User.avatarUrl/coverUrl — mai il file stesso nel database.
  mediaKey    String?
  // Un Update di tipo IMAGE/VIDEO può facoltativamente comportarsi anche da Domanda (risposta
  // privata, come il tipo QUESTION puro) invece che da semplice foto/video con didascalia — non
  // esclusivo con `type`, un aggiunta in più. Per gli Update di tipo QUESTION puro resta false:
  // il controllo "è una domanda?" guarda `type === QUESTION || isQuestion`, mai solo questo campo.
  isQuestion  Boolean    @default(false)
  // Un Update può facoltativamente puntare a un Episodio o Journey del creator (es. "è uscito il
  // nuovo episodio"), indipendentemente dal suo `type` — non sono a vicenda esclusivi con testo/
  // foto/video/sondaggio/domanda, sono un aggancio in più.
  linkedJourneyId String?
  linkedJourney   Journey? @relation(fields: [linkedJourneyId], references: [id])
  linkedEpisodeId String?
  linkedEpisode   Episode? @relation(fields: [linkedEpisodeId], references: [id])
  publishedAt DateTime   @default(now())
  archivedAt  DateTime? // impostato automaticamente 24h dopo la pubblicazione
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  pollOptions PollOption[]
  votes       UpdateVote[]
  views       UpdateView[]
  answers     UpdateAnswer[]
  reactions   UpdateReaction[]

  @@map("updates")
}

// Opzioni di un Update di tipo POLL (2-4 per sondaggio, vedi lib/constants/updates.ts).
model PollOption {
  id        String   @id @default(uuid())
  updateId  String
  update    Update   @relation(fields: [updateId], references: [id], onDelete: Cascade)
  label     String
  order     Int
  createdAt DateTime @default(now())

  votes UpdateVote[]

  @@index([updateId, order])
  @@map("update_poll_options")
}

// Un voto per persona per sondaggio, non modificabile dopo il voto (decisione presa con Manuel).
model UpdateVote {
  id        String     @id @default(uuid())
  updateId  String
  update    Update     @relation(fields: [updateId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  createdAt DateTime   @default(now())

  @@unique([updateId, userId])
  @@map("update_votes")
}

// Traccia chi ha già visto quale Update: base per il contorno "visto/non visto" dei cerchi
// in stile Stories nella Home (nessuna tabella equivalente esisteva prima).
model UpdateView {
  id       String   @id @default(uuid())
  updateId String
  update   Update   @relation(fields: [updateId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  viewedAt DateTime @default(now())

  @@unique([updateId, userId])
  @@map("update_views")
}

// Risposta a un Update di tipo QUESTION: visibile solo al creator (mai pubblica), una
// risposta per persona per domanda.
model UpdateAnswer {
  id        String   @id @default(uuid())
  updateId  String
  update    Update   @relation(fields: [updateId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@unique([updateId, userId])
  @@map("update_answers")
}

// Reazione rapida a un tocco (emoji), non un commento: un tocco per persona per Update, il
// tocco più recente sostituisce il precedente se la persona cambia idea.
model UpdateReaction {
  id        String   @id @default(uuid())
  updateId  String
  update    Update   @relation(fields: [updateId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  emoji     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([updateId, userId])
  @@map("update_reactions")
}

// ------------------------------------------------------------
// COMMUNITY
// ------------------------------------------------------------

model Community {
  id          String        @id @default(uuid())
  creatorId   String        @unique
  creator     Creator       @relation(fields: [creatorId], references: [id])
  title       String
  description String?
  isFree      Boolean       @default(true)
  price       Decimal?      @db.Money // null se isFree = true
  status      ListingStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members   CommunityMember[]
  purchases Purchase[]

  @@map("communities")
}

model CommunityMember {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  joinedAt    DateTime  @default(now())
  status      ListingStatus @default(ACTIVE)

  @@unique([communityId, userId])
  @@map("community_members")
}

// ------------------------------------------------------------
// WORKSHOP / EVENT / DIGITAL PRODUCT / PERSONAL SERVICE
// ------------------------------------------------------------

model Workshop {
  id          String        @id @default(uuid())
  creatorId   String
  creator     Creator       @relation(fields: [creatorId], references: [id])
  title       String
  description String?
  // Interruttore "Gratuito" (Punto 8 dell'allineamento, richiesto da Manuel il 2026-09-25): se
  // true, price resta null e il workshop mostra un pulsante "Partecipo" reale (WorkshopRsvp)
  // invece del prezzo/pagamento, che resta "Coming soon" finché Stripe non è collegato.
  isFree      Boolean       @default(false)
  price       Decimal?      @db.Money // null se isFree = true
  // Quando si svolge davvero il workshop — distinto da presaleReleaseAt (quando si aprono le
  // prevendite), campo mancante nello schema originale, aggiunto per permettere all'AI/al
  // creator di indicare una data reale (es. "il 23 febbraio").
  startsAt    DateTime?
  // Chiave R2 della copertina (stesso pattern di Journey.coverUrl), aggiunta il 2026-09-26 dopo
  // test reale di Manuel: creare un evento senza poter caricare una foto sembrava incompleto.
  coverUrl    String?
  location    String? // indirizzo fisico o link online, visibile a tutti
  status      ListingStatus @default(DRAFT)
  presaleReleaseAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  purchases     Purchase[]
  discountCodes DiscountCode[]
  rsvps         WorkshopRsvp[]

  @@map("workshops")
}

model Event {
  id          String        @id @default(uuid())
  creatorId   String
  creator     Creator       @relation(fields: [creatorId], references: [id])
  title       String
  description String?
  isFree      Boolean       @default(false)
  price       Decimal?      @db.Money // null se isFree = true
  startsAt    DateTime?
  coverUrl    String?
  location    String? // indirizzo fisico o link online, visibile a tutti
  status      ListingStatus @default(DRAFT)
  presaleReleaseAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  purchases     Purchase[]
  discountCodes DiscountCode[]
  rsvps         EventRsvp[]

  @@map("events")
}

// Iscrizione reale (non un pagamento) a un Workshop/Evento gratuito: chi ha cliccato "Partecipo".
// FK dedicate separate invece di una tabella unica polimorfica, stesso principio già scelto per
// Purchase (vedi intestazione del file) — Workshop ed Event restano due modelli distinti.
model WorkshopRsvp {
  id         String   @id @default(uuid())
  workshopId String
  workshop   Workshop @relation(fields: [workshopId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([workshopId, userId])
  @@map("workshop_rsvps")
}

// Immagini create dall'AI nella chat Community (Punto 8): una riga per immagine, serve per il
// limite giornaliero per creator (costano circa 3 centesimi l'una, vedi lib/ai/communityImage.ts).
// r2Key punta al file su R2 sotto "ai-images/{userId}/".
model AiImageGeneration {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  r2Key     String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("ai_image_generations")
}

model EventRsvp {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@map("event_rsvps")
}

model DigitalProduct {
  id          String        @id @default(uuid())
  creatorId   String
  creator     Creator       @relation(fields: [creatorId], references: [id])
  title       String
  description String?
  price       Decimal       @db.Money
  // Null finché il creator non carica il file (stesso principio di Journey.coverUrl): la riga
  // nasce in Bozza senza file, il file si aggiunge dopo tramite updateCommunityListing.
  fileUrl     String?
  coverUrl    String?
  status      ListingStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  purchases     Purchase[]
  discountCodes DiscountCode[]

  @@map("digital_products")
}

model PersonalService {
  id          String        @id @default(uuid())
  creatorId   String
  creator     Creator       @relation(fields: [creatorId], references: [id])
  title       String
  description String?
  price       Decimal       @db.Money
  coverUrl    String?
  status      ListingStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  purchases     Purchase[]
  discountCodes DiscountCode[]

  @@map("personal_services")
}

// ------------------------------------------------------------
// PURCHASE — FK dedicate invece di riferimento polimorfico
// ------------------------------------------------------------

model Purchase {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  type       PurchaseType

  communityId       String?
  community         Community?       @relation(fields: [communityId], references: [id])
  workshopId        String?
  workshop          Workshop?        @relation(fields: [workshopId], references: [id])
  eventId           String?
  event             Event?           @relation(fields: [eventId], references: [id])
  digitalProductId  String?
  digitalProduct    DigitalProduct?  @relation(fields: [digitalProductId], references: [id])
  personalServiceId String?
  personalService   PersonalService? @relation(fields: [personalServiceId], references: [id])

  discountCodeId String?
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id])

  price      Decimal        @db.Money
  commission Decimal        @db.Money
  status     PurchaseStatus @default(PENDING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  payment Payment?

  // Vincolo applicativo: esattamente una tra communityId/workshopId/eventId/
  // digitalProductId/personalServiceId deve essere valorizzata, coerente con `type`.
  // Da imporre con un CHECK constraint SQL o validazione a livello service.

  @@map("purchases")
}

// ------------------------------------------------------------
// TIP
// ------------------------------------------------------------

model Tip {
  id        String   @id @default(uuid())
  creatorId String
  creator   Creator  @relation(fields: [creatorId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Decimal  @db.Money
  anonymous Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("tips")
}

// ------------------------------------------------------------
// DISCOUNT CODE — con targeting esplicito
// ------------------------------------------------------------

model DiscountCode {
  id          String   @id @default(uuid())
  creatorId   String
  creator     Creator  @relation(fields: [creatorId], references: [id])
  code        String   @unique
  percentage  Int // 1-100
  maxUses     Int?
  currentUses Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Se tutti null => sconto valido su tutta l'offerta del creator
  workshopId        String?
  workshop          Workshop?        @relation(fields: [workshopId], references: [id])
  eventId           String?
  event             Event?           @relation(fields: [eventId], references: [id])
  digitalProductId  String?
  digitalProduct    DigitalProduct?  @relation(fields: [digitalProductId], references: [id])
  personalServiceId String?
  personalService   PersonalService? @relation(fields: [personalServiceId], references: [id])

  purchases Purchase[]

  @@map("discount_codes")
}

// ------------------------------------------------------------
// FOLLOW — persona segue persona, indipendente dallo stato di Creator
// (chi ha pubblicato un Journey è comunque un utente come tutti gli
// altri, vedi 00-project-context.md sezione "Modello utente unico")
// ------------------------------------------------------------

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("Following", fields: [followerId], references: [id])
  followingId String
  following   User     @relation("Followers", fields: [followingId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@map("follows")
}

// Blocco utente (Settings > Privacy, 2026-10-01): bloccare qualcuno annulla subito ogni "segui"
// reciproco tra i due (lib/actions/block.ts), impedisce nuovi follow e messaggi in entrambe le
// direzioni finché dura, e rende il profilo "non disponibile" per entrambi. Non simmetrico nei
// dati (solo blockerId→blockedId), ma i controlli (lib/actions/block.ts, isBlockedEitherWay)
// guardano sempre entrambe le direzioni: bloccare è un'azione di una persona verso l'altra, non
// serve un blocco reciproco perché l'effetto da entrambi i lati è lo stesso.
model Block {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id])
  blockedId String
  blocked   User     @relation("BlockedBy", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@map("blocks")
}

// Pick "Wildcard" stabile per categoria, pagina /journeys (lib/discovery/wildcard.ts): una sola
// riga per categoria, ricalcolata pigramente alla lettura se più vecchia di 24 ore (stesso
// principio del Journey Score: niente cron, il ricalcolo avviene solo alla prossima visita utile).
model WildcardPick {
  id        String   @id @default(uuid())
  category  String   @unique
  journeyId String
  journey   Journey  @relation(fields: [journeyId], references: [id])
  pickedAt  DateTime @default(now())

  @@map("wildcard_picks")
}

// ------------------------------------------------------------
// MESSAGING — conversazioni 1:1, permesse se almeno una delle due persone
// segue l'altra (non serve il follow reciproco, vedi 00-project-context.md,
// sezione "Follow universale"). Solo testo nella V1 (19_Messaging.md).
// ------------------------------------------------------------

// userAId/userBId sono normalizzati (userAId sempre < userBId, ordine lessicografico
// sugli id) così la coppia di persone ha sempre una sola riga possibile, a prescindere
// da chi ha scritto per primo — a differenza di Follow, dove le due direzioni contano
// come righe distinte.
model Conversation {
  id            String   @id @default(uuid())
  userAId       String
  userA         User     @relation("ConversationsAsA", fields: [userAId], references: [id])
  userBId       String
  userB         User     @relation("ConversationsAsB", fields: [userBId], references: [id])
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages Message[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ------------------------------------------------------------
// LIKE (Episodi e Update — nessun sistema di commenti, vedi 12_MVP_Features.md)
// ------------------------------------------------------------

model Like {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  targetType LikeTargetType
  // Id dell'Episodio o dell'Update, a seconda di targetType: nessuna relation
  // diretta perché un solo campo Like deve poter puntare a due modelli diversi.
  targetId   String
  createdAt  DateTime       @default(now())

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("likes")
}

// ------------------------------------------------------------
// NOTIFICATION
// ------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  content   String
  // Percorso interno da aprire al click (es. "/journeys/abc"), null per i tipi che non ne hanno bisogno.
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

// ------------------------------------------------------------
// ANALYTICS — snapshot storico, non specchio in tempo reale
// ------------------------------------------------------------

model Analytics {
  id              String   @id @default(uuid())
  creatorId       String
  creator         Creator  @relation(fields: [creatorId], references: [id])
  journeyId       String?
  journey         Journey? @relation(fields: [journeyId], references: [id])
  completionRate  Float
  journeyScore    Float
  inspirationRate Float
  trustLevel      Int
  capturedAt      DateTime @default(now())

  @@index([creatorId, capturedAt])
  @@map("analytics_snapshots")
}

// ------------------------------------------------------------
// REPORT (moderazione — schema minimo, da estendere con Trust System)
// ------------------------------------------------------------

model Report {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  targetType ReportTargetType
  targetId   String
  reason     String
  status     ReportStatus     @default(PENDING)
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?

  @@map("reports")
}

// ------------------------------------------------------------
// PAYMENT
// ------------------------------------------------------------

model Payment {
  id         String        @id @default(uuid())
  purchaseId String        @unique
  purchase   Purchase      @relation(fields: [purchaseId], references: [id])
  stripeId   String        @unique
  amount     Decimal       @db.Money
  commission Decimal       @db.Money
  status     PaymentStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@map("payments")
}
