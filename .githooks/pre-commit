#!/bin/sh
# Lucchetto del design system Zero: blocca il commit se app/ o components/ contengono un
# pezzo di stile fatto a mano invece dei mattoncini ufficiali (components/ui/), o un confine
# telefono/computer sbagliato (sm: invece di md:). Vedi scripts/check-design.mjs e
# docs/15_Design_System.md. Per saltarlo una volta sola (sconsigliato): git commit --no-verify.
node scripts/check-design.mjs || exit 1

# Lucchetto "il desktop non si tocca": blocca il commit se le modifiche non ancora committate
# cambiano come appare il sito a schermo largo rispetto all'ultimo commit. Vedi
# scripts/check-desktop-isolation.mjs. Se il cambiamento sul computer è voluto (confermato con
# Manuel, non un md: dimenticato): ALLOW_DESKTOP_CHANGE=1 git commit ...
node scripts/check-desktop-isolation.mjs || exit 1

# Lucchetto "il mobile non si tocca" (gemello del precedente): blocca il commit se le modifiche
# cambiano come appare il sito a schermo da telefono (390px). Serve quando il lavoro è sul
# computer: il telefono non deve cambiare. Vedi scripts/check-mobile-isolation.mjs.
# Se il cambiamento sul telefono è voluto (confermato con Manuel): ALLOW_MOBILE_CHANGE=1 git commit ...
node scripts/check-mobile-isolation.mjs || exit 1

# Lucchetto "ogni pezzo è uguale in tutto il sito": legge come sono davvero disegnati card, bottoni,
# titoli, riquadri e pillole in tutte le pagine (telefono e computer) e blocca il commit se un pezzo
# appare in un modo nuovo. Serve il sito acceso (npm run dev): se è spento avvisa e non blocca.
# Vedi scripts/check-consistency.mjs. Se la diversità è voluta: node scripts/check-consistency.mjs --write-baseline
node scripts/check-consistency.mjs
status=$?
if [ "$status" = "2" ]; then
  echo "ATTENZIONE: controllo di coerenza NON eseguito (sito spento). Avvia npm run dev e lancia npm run check:consistency prima di fare push."
elif [ "$status" != "0" ]; then
  exit 1
fi
