# Database (Neon — Prisma Postgres)
# DATABASE_URL: connessione pooled, usata dall'app in runtime
# DIRECT_URL: connessione diretta (non pooled), usata solo per le migration
DATABASE_URL=""
DIRECT_URL=""

# Better Auth
# Genera un valore con: npx @better-auth/cli secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Da configurare più avanti
# RESEND_API_KEY=""
# STRIPE_SECRET_KEY=""

# Cloudflare R2 (upload video degli Episodi)
# R2_ENDPOINT: https://<account-id>.r2.cloudflarestorage.com — richiede una CORS Policy
# impostata dal pannello Cloudflare (bucket → Settings → CORS Policy) per permettere
# l'upload diretto dal browser, non configurabile da queste chiavi.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_ENDPOINT=""
