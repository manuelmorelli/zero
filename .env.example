# Database (Neon — Prisma Postgres)
# DATABASE_URL: connessione pooled, usata dall'app in runtime
# DIRECT_URL: connessione diretta (non pooled), usata solo per le migration
DATABASE_URL=""
DIRECT_URL=""

# Better Auth
# Genera un valore con: npx @better-auth/cli secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Protegge app/api/cron/purge-accounts (cancellazione account dopo il periodo di grazia,
# vedi vercel.json e lib/account/deletion.ts) da chiamate esterne non autorizzate. Su Vercel,
# se la variabile si chiama esattamente CRON_SECRET, Vercel Cron la allega da sola come header
# Authorization — genera un valore casuale qualsiasi (es. openssl rand -hex 32).
CRON_SECRET=""

# Da configurare più avanti
# RESEND_API_KEY=""
# STRIPE_SECRET_KEY=""

# Indirizzo che riceve una mail di avviso a ogni segnalazione di contenuto (lib/actions/report.ts).
# Senza RESEND_API_KEY configurata sopra, l'avviso resta comunque visibile solo nei log del
# server (console), non arriva davvero via email.
# ADMIN_NOTIFICATION_EMAIL=""

# Email degli amministratori, separate da virgola: chi accede con una di queste vede il pannello
# /admin/reports (lib/admin.ts). Senza questa variabile nessuno vede il pannello.
# ADMIN_EMAILS=""

# Primo filtro automatico su testo e immagini appena caricati (lib/moderation.ts), tramite
# l'endpoint di moderazione gratuito di OpenAI. Richiede un account gratuito su platform.openai.com
# e una API key (Dashboard -> API keys). Finché questa variabile è vuota, il filtro non blocca
# nulla — l'app continua a funzionare normalmente, esattamente come oggi.
# OPENAI_API_KEY=""

# Cloudflare R2 (upload video degli Episodi)
# R2_ENDPOINT: https://<account-id>.r2.cloudflarestorage.com — richiede una CORS Policy
# impostata dal pannello Cloudflare (bucket → Settings → CORS Policy) per permettere
# l'upload diretto dal browser, non configurabile da queste chiavi.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_ENDPOINT=""

# Google AI Studio (Gemini) — chiave gratuita creata su ai.google.dev, con l'account Google
# dedicato al progetto Zero. Usata dalla chat AI Community e dalla moderazione dei contenuti.
# GEMINI_API_KEY=""

# Creazione immagini nella chat AI Community ("Nano Banana", lib/ai/communityImage.ts). NON è
# gratuita: circa 0,034 dollari a immagine, richiede la fatturazione attiva sul progetto Google.
# Mettere "true" solo dopo averla attivata. Tetto: 5 immagini al giorno per creator.
# GEMINI_IMAGE_GENERATION_ENABLED="false"

# Mappa dei Momenti (lib/ai/episodeMoments.ts): l'AI guarda ogni episodio una volta e scrive appunti
# su cosa succede a ogni minuto, base per ricerca semantica, trailer automatico e un futuro Percorso
# su Misura. Spenta di default: mettere "true" solo dopo aver controllato i risultati su pochi
# episodi di prova (vedi scripts/extract-episode-moments.ts). Costo per episodio trascurabile su
# video brevi come quelli di oggi, da ricontrollare se gli episodi diventeranno molto più lunghi.
# MOMENTS_LIBRARY_ENABLED="false"

# Cloudflare Stream (versioni leggere dei video per connessioni lente, vedi lib/stream.ts) — il
# file originale su R2 sopra NON viene mai toccato, questa è solo una copia aggiuntiva. Finché
# queste variabili sono vuote la funzione resta disattivata: l'app continua a funzionare
# normalmente servendo solo il video originale, esattamente come oggi.
#
# Come attivarla:
# 1. Abilitare Cloudflare Stream sull'account Cloudflare (stesso account di R2 sopra, dashboard
#    → Stream) — ha un costo a consumo, vedi doc/piano condiviso con Manuel.
# 2. Creare un API Token con permesso "Stream:Edit" (dashboard → Manage Account → API Tokens).
# 3. CLOUDFLARE_ACCOUNT_ID è lo stesso valore di R2_ACCOUNT_ID sopra.
# 4. CLOUDFLARE_STREAM_WEBHOOK_SECRET si ottiene registrando l'URL del webhook
#    (https://<dominio-produzione>/api/webhooks/stream) con una chiamata all'API di Cloudflare —
#    farla fare a chi configura l'ambiente, non va fatta da qui.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""
CLOUDFLARE_STREAM_WEBHOOK_SECRET=""
